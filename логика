using System;
using System.Linq;
using System.Text.RegularExpressions;
using System.Windows;
using System.Xml.Linq;
using WpfApp6;
using WpfApp6.Models;

namespace WpfApp6
{
    public partial class AddEditWindow : Window
    {
        private ShoeStoreDb2Context _db;
        private Tovar _product;
        private bool _isEdit;

        public AddEditWindow()
        {
            InitializeComponent();
            _db = new ShoeStoreDb2Context();

            if (GlobalData.CurrentProduct != null)
            {
                _isEdit = true;
                _product = GlobalData.CurrentProduct;
                lblTitle.Text = "Редактирование товара";
                LoadProductData();
            }
            else
            {
                _isEdit = false;
                _product = new Tovar();
                lblTitle.Text = "Добавление товара";
            }
        }

        private void LoadProductData()
        {
            if (_product == null) return;
            tbArticle.Text = _product.Артикул;
            tbName.Text = _product.НаименованиеТовара;
            tbCategory.Text = _product.КатегорияТовара;
            tbManufacturer.Text = _product.Производитель;
            tbSupplier.Text = _product.Поставщик;
            tbPrice.Text = _product.Цена;
            tbDiscount.Text = _product.ДействующаяСкидка ?? "0";
            tbStock.Text = _product.КолВоНаСкладе;
            tbDescription.Text = _product.ОписаниеТовара;
        }

        private bool ValidateFields()
        {
            if (string.IsNullOrWhiteSpace(tbArticle.Text))
            {
                MessageBox.Show("Введите артикул!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                tbArticle.Focus();
                return false;
            }

            if (string.IsNullOrWhiteSpace(tbName.Text))
            {
                MessageBox.Show("Введите наименование товара!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                tbName.Focus();
                return false;
            }

            if (!string.IsNullOrWhiteSpace(tbCategory.Text))
            {
                if (Regex.IsMatch(tbCategory.Text, @"\d"))
                {
                    MessageBox.Show("Категория не должна содержать цифры!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbCategory.Focus();
                    tbCategory.SelectAll();
                    return false;
                }
            }

            if (!string.IsNullOrWhiteSpace(tbManufacturer.Text))
            {
                if (Regex.IsMatch(tbManufacturer.Text, @"\d"))
                {
                    MessageBox.Show("Производитель не должен содержать цифры!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbManufacturer.Focus();
                    tbManufacturer.SelectAll();
                    return false;
                }
            }

            if (!string.IsNullOrWhiteSpace(tbSupplier.Text))
            {
                if (Regex.IsMatch(tbSupplier.Text, @"\d"))
                {
                    MessageBox.Show("Поставщик не должен содержать цифры!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbSupplier.Focus();
                    tbSupplier.SelectAll();
                    return false;
                }
            }

            if (!string.IsNullOrWhiteSpace(tbPrice.Text))
            {
                if (!Regex.IsMatch(tbPrice.Text, @"^\d+$"))
                {
                    MessageBox.Show("Цена должна содержать только цифры!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbPrice.Focus();
                    tbPrice.SelectAll();
                    return false;
                }
            }

            if (!string.IsNullOrWhiteSpace(tbStock.Text))
            {
                if (!Regex.IsMatch(tbStock.Text, @"^\d+$"))
                {
                    MessageBox.Show("Количество должно быть целым числом!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbStock.Focus();
                    tbStock.SelectAll();
                    return false;
                }
            }

            if (!string.IsNullOrWhiteSpace(tbDiscount.Text))
            {
                if (!Regex.IsMatch(tbDiscount.Text, @"^\d+$"))
                {
                    MessageBox.Show("Скидка должна содержать только цифры!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                    tbDiscount.Focus();
                    tbDiscount.SelectAll();
                    return false;
                }

                if (int.TryParse(tbDiscount.Text, out int discount))
                {
                    if (discount < 0 || discount > 100)
                    {
                        MessageBox.Show("Скидка должна быть от 0 до 100%!", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        tbDiscount.Focus();
                        tbDiscount.SelectAll();
                        return false;
                    }
                }
            }

            return true;
        }

        private void btnSave_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (!ValidateFields()) return;

                _product.Артикул = tbArticle.Text.Trim();
                _product.НаименованиеТовара = tbName.Text.Trim();
                _product.КатегорияТовара = tbCategory.Text.Trim();
                _product.Производитель = tbManufacturer.Text.Trim();
                _product.Поставщик = tbSupplier.Text.Trim();
                _product.Цена = tbPrice.Text.Trim();
                _product.ДействующаяСкидка = tbDiscount.Text.Trim();
                _product.КолВоНаСкладе = tbStock.Text.Trim();
                _product.ОписаниеТовара = tbDescription.Text.Trim();

                if (_isEdit)
                {
                    _db.Tovars.Update(_product);
                }
                else
                {
                    if (_db.Tovars.Any(p => p.Артикул == _product.Артикул))
                    {
                        MessageBox.Show("Товар с таким артикулом уже существует!", "Ошибка",
                            MessageBoxButton.OK, MessageBoxImage.Warning);
                        tbArticle.Focus();
                        return;
                    }
                    _db.Tovars.Add(_product);
                }

                _db.SaveChanges();

                MessageBox.Show(_isEdit ? "Товар обновлен!" : "Товар добавлен!", "Успех",
                    MessageBoxButton.OK, MessageBoxImage.Information);

                this.DialogResult = true;
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка: {ex.Message}", "Ошибка",
                    MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void btnCancel_Click(object sender, RoutedEventArgs e)
        {
            this.DialogResult = false;
            this.Close();
        }
    }
}
